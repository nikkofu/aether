[Unit]
Description=Aether Observability API
After=network-online.target aetherd.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/aether/current
EnvironmentFile=-/etc/aether/aether-runtime.env
ExecStart=/opt/aether/current/bin/observability_api
Restart=on-failure
RestartSec=5s
NoNewPrivileges=true
PrivateTmp=true
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
