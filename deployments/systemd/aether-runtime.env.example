# Shared runtime paths
AETHER_RUNTIME_DATABASE_PATH=/var/lib/aether/aether.db
OBSERVABILITY_API_DATABASE_PATH=/var/lib/aether/aether.db

# Service ports
AETHERD_PORT=8090
OBSERVABILITY_API_PORT=8082

# Local runtime identity
AETHER_APP_MODE=cluster-leader
AETHER_APP_NODE_ID=prod-node-1
AETHER_APP_ROLE=general

# Default local model path
AETHER_OLLAMA_BASE_URL=http://127.0.0.1:11434
AETHER_OLLAMA_MODEL=gemma3:270m
AETHER_OLLAMA_TEMPERATURE=0.7
AETHER_OLLAMA_TIMEOUT=300s

# Logging
AETHER_LOG_LEVEL=info
AETHER_LOG_FORMAT=json

# Optional webhook signature validation
AETHER_GITHUB_WEBHOOK_SECRET=change-me

# Optional OTLP export. Leave unset for local-only trace persistence.
# OTEL_EXPORTER_OTLP_ENDPOINT=127.0.0.1:4317
