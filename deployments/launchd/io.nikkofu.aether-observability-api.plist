<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>io.nikkofu.aether-observability-api</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/opt/aether/current/deployments/launchd/run-observability-api.sh</string>
  </array>

  <key>EnvironmentVariables</key>
  <dict>
    <key>AETHER_INSTALL_ROOT</key>
    <string>/opt/aether/current</string>
    <key>AETHER_ENV_FILE</key>
    <string>/opt/aether/shared/aether-runtime.env</string>
  </dict>

  <key>WorkingDirectory</key>
  <string>/opt/aether/current</string>

  <key>KeepAlive</key>
  <true/>

  <key>RunAtLoad</key>
  <true/>

  <key>ProcessType</key>
  <string>Background</string>

  <key>ThrottleInterval</key>
  <integer>5</integer>

  <key>StandardOutPath</key>
  <string>/opt/aether/state/log/observability-api.log</string>

  <key>StandardErrorPath</key>
  <string>/opt/aether/state/log/observability-api.log</string>
</dict>
</plist>
